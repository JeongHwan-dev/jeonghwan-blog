{
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "oxc.oxc-vscode",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "editor.tabSize": 2,
  "cSpell.userWords": [
    "jeonghwan",
    "pretendard",
    "notionhq",
    "vaul",
    "tossface",
    "giscus",
    "shadcn"
  ],
  "css.lint.unknownAtRules": "ignore",
  "tailwindCSS.classFunctions": ["clsx", "cn", "cva", "tv"]
}
